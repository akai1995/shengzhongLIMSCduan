{
    "easycom": {
        "autoscan": true,
        "custom": {
			"^ut-(.*)": "@/components/custom-ui/ut-$1/ut-$1.vue", "^project-(.*)": "@/components/project-ui/project-$1/project-$1.vue",
			"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue", "e-charts": "@/components/e-chart/e-chart.vue",
	    	"^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "@/uni_modules/z-paging/components/z-paging$1/z-paging$1.vue"
