{
    "easycom": {
        "autoscan": true,
        "custom": {
			"^ut-(.*)": "@/components/custom-ui/ut-$1/ut-$1.vue", "^project-(.*)": "@/components/project-ui/project-$1/project-$1.vue",
			"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue",
	    	"^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "@/uni_modules/z-paging/components/z-paging$1/z-paging$1.vue"
        }
    },
	"pages": [
		{ "path": "pages/tabs/tab1/tab1", "name": "tab1Page", "style": { "navigationBarTitleText": "设备预约", "enablePullDownRefresh": false	} },
		{ "path": "pages/tabs/tab5/tab5", "name": "tab5Page", "style": { "navigationBarTitleText": "我的", "enablePullDownRefresh": false	} },
		{ "path": "pages/404/404", "name": "unFound", "style": { "navigationStyle": "default", "enablePullDownRefresh": false, "navigationBarTitleText": "页面丢失了"	} }
	],
	"subPackages": [
		{
			"root": "sub-pack/project-pages",
			"pages": [		
				{ "path": "article-detail/article-detail", "name": "articleDetail", "style": { "navigationBarTitleText": "", "navigationStyle": "custom", "enablePullDownRefresh": false, "navigationBarBackgroundColor": "#ffffff00" } },
				{ "path": "login/login", "name": "login", "style": { "navigationBarTitleText": "登录", "enablePullDownRefresh": false, "navigationBarBackgroundColor": "#ffffff00" } }
			]
		},
		{
			"root": "sub-pack/chat",
			"pages": [
				{ "path": "chat-stream/chat-stream", "name": "chatStream", "style": { "navigationBarTitleText": "报告分析", "enablePullDownRefresh": false } }
			]
		},
		{
			"root": "sub-pack/tab1",
			"pages": [
				{ "path": "device/detail", "name": "deviceDetail", "style": { "navigationBarTitleText": "设备详情", "enablePullDownRefresh": false } },
				{ "path": "ocr-recog/ocr-recog", "name": "ocrRecognition", "style": { "navigationBarTitleText": "图文识别", "enablePullDownRefresh": false } }
			]
		},
		{
			"root": "sub-pack/tab5",
			"pages": [
				{ "path": "reserve/reserve", "name": "reserve", "style": { "navigationBarTitleText": "我的预约", "enablePullDownRefresh": false } },
				{ "path": "reserve/detail", "name": "reserveDetail", "style": { "navigationBarTitleText": "预约详情", "enablePullDownRefresh": false } },
				{ "path": "sign-doc/sign-doc", "name": "signDoc", "style": { "navigationBarTitleText": "我的待签署", "enablePullDownRefresh": false } },
				{ "path": "sign-doc/doc-sign", "name": "docSign", "style": { "navigationBarTitleText": "文件签署", "enablePullDownRefresh": false } }
			]
		}
	],
	"globalStyle": { "navigationStyle": "custom", "navigationBarTextStyle": "black", "navigationBarTitleText": "e-AI", "navigationBarBackgroundColor": "#F8F8F8", "backgroundColor": "#F8F8F8" },
	"condition": {
		"current": 0,
		"list": [
			{ "name": "报告分析", "path": "/sub-pack/chat/chat-stream/chat-stream", "query": "" },
			{ "name": "图片识别", "path": "/sub-pack/tab1/ocr-recog/ocr-recog", "query": "" }
		]
	}
}

