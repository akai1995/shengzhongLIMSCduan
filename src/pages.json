{
    "easycom": {
        "autoscan": true,
        "custom": {
			"^ut-(.*)": "@/components/custom-ui/ut-$1/ut-$1.vue",
			"^project-(.*)": "@/components/project-ui/project-$1/project-$1.vue",
			"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue",
			"^Recorder-(.*)": "@/uni_modules/Recorder-UniCore/components/Recorder-$1/Recorder-$1.vue",			
	    	"^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "@/uni_modules/z-paging/components/z-paging$1/z-paging$1.vue"
        }
    },
	"pages": [
		{
			"path": "pages/tabs/tab1/tab1",
			"style": {
				"navigationBarTitleText": "设备预约",
				"enablePullDownRefresh": false
			}
		},
		// {
		// 	"path": "pages/tabs/tab1/sign-doc",
		// 	"style": {
		// 		"navigationBarTitleText": "待签署文件",
		// 		"enablePullDownRefresh": false
		// 	}
		// },
		{
			"path": "pages/tabs/tab5/tab5",
			"style": {
				"navigationBarTitleText": "我的",
				"enablePullDownRefresh": false
			}
		},
		// {
		// 	"path": "pages/launch/launch",
		// 	"style": {
		// 		"navigationBarTitleText": "eAI",
		// 		"enablePullDownRefresh": false
		// 	}
		// },
		{
			"path": "pages/404/404",
			"style": {
				"navigationStyle": "default",
				"enablePullDownRefresh": false,
				"navigationBarTitleText": "页面丢失了"
			}
		}
	],
	"subPackages": [
		{
			"root": "sub-pack/project-pages",
			"pages": [		
				{
					"path": "article-detail/article-detail",					
					"style": {
						"navigationBarTitleText": "",
						"navigationStyle": "custom",
						"enablePullDownRefresh": false,
						"navigationBarBackgroundColor": "#ffffff00"
					}
				},
				{
					"path": "login/login",					
					"style": {
						"navigationBarTitleText": "登录",
						"enablePullDownRefresh": false,
						"navigationBarBackgroundColor": "#ffffff00"
					}
				}
			]
		},
		{
			"root": "sub-pack/tab1",
			"pages": [
				{
					"path": "chat-stream/chat-stream",
					"style": {
						"navigationBarTitleText": "报告分析",
						"enablePullDownRefresh": false
					}
				},
				// {
				// 	"path": "chat-stream/preview",
				// 	"style": {
				// 		"navigationBarTitleText": "文档预览",
				// 		"enablePullDownRefresh": false
				// 	}
				// },	
				{
					"path": "device/detail",
					"style": {
						"navigationBarTitleText": "设备详情",
						"enablePullDownRefresh": false
					}
				},
				{
					"path": "ocr-recognition/ocr-recognition",
					"style": {
						"navigationBarTitleText": "图文识别",
						"enablePullDownRefresh": false
					}
				}
			]
		},
		{
			"root": "sub-pack/tab5",
			"pages": [
				{
					"path": "reserve/reserve",
					"style": {
						"navigationBarTitleText": "我的预约",
						"enablePullDownRefresh": false
					}
				},
				{
					"path": "reserve/detail",
					"style": {
						"navigationBarTitleText": "预约详情",
						"enablePullDownRefresh": false
					}
				},
				{
					"path": "sign-doc/sign-doc",
					"style": {
						"navigationBarTitleText": "我的待签署",
						"enablePullDownRefresh": false
					}
				},
				{
					"path": "sign-doc/doc-sign",
					"style": {
						"navigationBarTitleText": "文件签署",
						"enablePullDownRefresh": false
					}
				}
			]
		}
	],
	"globalStyle": {
		"navigationStyle": "custom",
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "eAI",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"condition": {
		"current": 0,
		"list": [
			{ "name": "报告分析", "path": "sub-pack/tab1/chat-stream/chat-stream", "query": "" },
			{ "name": "图片识别", "path": "sub-pack/tab1/ocr-recognition/ocr-recognition", "query": "" },
			// { "name": "文档预览", "path": "sub-pack/tab1/chat-stream/preview", "query": "ext=pdf&uri=http%253A%252F%252F192.168.0.151%253A9889%252Feai-lims%252Fsys%252Fcommon%252Fstatic%252Ftemp%252FWSkNYwOthG1zc4692bb1260e55c7d186be6ef46f8e3d_1769079056561.pdf" },				
			{ "name": "文件签署", "path": "/sub-pack/tab5/sign-doc/doc-sign", "query": "id=${id}&showSign=true" },
			{ "name": "我的预约", "path": "sub-pack/tab5/reserve/reserve", "query": "" }
		]
	}
