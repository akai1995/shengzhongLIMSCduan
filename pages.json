{
    "easycom": {
        "autoscan": true,
        "custom": {
			"^ut-(.*)": "@/components/ut-$1/ut-$1.vue",
			"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue",
			"^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "@/uni_modules/z-paging/components/z-paging$1/z-paging$1.vue"
        }
    },
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "设备预约"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "设备预约",
				"navigationStyle": "default",
				"enablePullDownRefresh": false,
				"navigationBarBackgroundColor": "#ffffff00"
			}
		},
		{
			"path": "pages/user/user",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/detail/index",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/reserve/index",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/reserve/detail",
			"style": {
				"navigationBarTitleText": "",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/device-appointment/index",
			"style": {
				"navigationBarTitleText": "设备预约",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/signPaper/index",
			"style": {
				"navigationBarTitleText": "待签署文件",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/signPaper/am-sign-input/am-sign-input",
			"style": {
				"navigationBarTitleText": "文件签署",
				"enablePullDownRefresh": false
			}
		}
	],
	"subPackages": [
		{
			"root": "pagesA",
			"pages": []
		}
	],
	"globalStyle": {
		"navigationStyle": "custom",
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "设备预约",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {},
	"condition": {
		"current": 0,
		"list": [
			{
				"name": "",
				"path": "",
				"query": ""
			}
		]
	}
}

